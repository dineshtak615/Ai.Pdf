{
  "version": 2,
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "tailwindcss4/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "tailwindcss4/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "tailwindcss4/build/index.html"
    }
  ]
}
